{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "Europe/Stockholm",
  "schedule": ["before 5am on Monday"],
  "enabledManagers": [
    "pep621",
    "npm",
    "dockerfile"  ],
  "npm": {
    "managerFilePatterns": ["/^web/package\\.json$/"]
  },
  "dockerfile": {
    "managerFilePatterns": ["/^(engine\\.)?Dockerfile$/"]
  },
  "hostRules": [
    {
      "matchHost": "pkgs.dev.azure.com",
      "hostType": "pypi",
      "username": "renovate",
      "password": "{{ secrets.AZURE_DEVOPS_TOKEN }}"
    }
  ],
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "non-major dependencies",
      "automerge": true
    },
    {
      "matchDepNames": ["conventional-changelog-conventionalcommits"],
      "allowedVersions": "<10"
    },
    {
      "matchDepNames": ["python"],
      "matchManagers": ["dockerfile"],
      "allowedVersions": "<3.15"
    },
    {
      "matchDepNames": ["equa-ci"],
      "enabled": false
    },
    {
      "matchPackageNames": ["/^ghcr\\.io/equa/equa-base/"],
      "enabled": false
    }
  ]}
